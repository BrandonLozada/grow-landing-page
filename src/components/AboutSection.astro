---
import { Image } from "astro:assets";
import ourStoryImage from "/src/assets/images/our-story.webp";

/*
  [TEMPORAL / PLACEHOLDER]
  - La imagen actual es un asset temporal proveniente de la plantilla original.
  - Se reemplazará en la Iteración 3 por una fotografía corporativa oficial de GROW.
*/

const aboutContent = {
  historia: {
    tag: "NUESTRA HISTORIA",
    title: "Nuestra historia",
    text: "Servicios Especializados GROW nace con el objetivo de brindar soluciones integrales en materia administrativa, contable y jurídica para empresas que buscan optimizar sus procesos internos. A través de una atención personalizada y un equipo comprometido con la excelencia, hemos construido relaciones de confianza con nuestros clientes, convirtiéndonos en un aliado estratégico para el crecimiento de sus organizaciones.",
  },
  mision: {
    title: "Misión",
    text: "Brindar soluciones administrativas, contables y jurídicas de alta calidad que permitan a nuestros clientes operar con eficiencia, seguridad y cumplimiento normativo, contribuyendo al desarrollo sostenible de sus empresas.",
  },
  vision: {
    title: "Visión",
    text: "Ser una empresa referente a nivel nacional en servicios especializados, reconocida por la calidad de nuestros procesos, la confianza de nuestros clientes y nuestro compromiso con la mejora continua.",
  },
};
---

<section id="nosotros" class="about">
  <div class="section-container">
    <div class="about-header">
      <span class="section-tag">{aboutContent.historia.tag}</span>
      <h2 class="section-title">{aboutContent.historia.title}</h2>
    </div>
    <div class="about-container">
      <div class="about-image-wrapper">
        <!-- Placeholder: imagen temporal del template original -->
        <Image
          src={ourStoryImage}
          alt="Servicios Especializados GROW - Equipo corporativo"
          class="media"
        />
      </div>
      <div class="about-content">
        <!-- Bloque: Historia -->
        <div class="about-block" data-block="historia">
          <p class="about-text">{aboutContent.historia.text}</p>
        </div>

        <!-- Bloque: Misión -->
        <div class="about-block" data-block="mision">
          <h3 class="section-subtitle about-subtitle">
            {aboutContent.mision.title}
          </h3>
          <p class="about-text">{aboutContent.mision.text}</p>
        </div>

        <!-- Bloque: Visión -->
        <div class="about-block" data-block="vision">
          <h3 class="section-subtitle about-subtitle">
            {aboutContent.vision.title}
          </h3>
          <p class="about-text">{aboutContent.vision.text}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-header .section-title {
    margin-bottom: var(--px-32);
  }

  .about-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px-64);
    align-items: start;
  }

  .about-image-wrapper {
    width: 100%;
    height: 100%;
    min-height: 28.125rem;
    overflow: hidden;
    aspect-ratio: 4/3;
    position: sticky;
    top: var(--px-96);
    border-radius: var(--radius-md);
  }

  .about-content {
    max-width: 37.5rem;
  }

  .about-block {
    margin-bottom: var(--px-40);
  }

  .about-block:last-child {
    margin-bottom: 0;
  }

  .about-subtitle {
    margin-bottom: var(--px-12);
  }

  .about-text {
    margin-bottom: 0;
    line-height: 1.7;
  }

  @media screen and (max-width: 64rem) {
    .about-container {
      gap: var(--px-32);
    }

    .about-image-wrapper {
      min-height: 25rem;
      position: static;
    }

    .about-content {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 48rem) {
    .about-container {
      grid-template-columns: 1fr;
      gap: var(--px-32);
    }

    .about-image-wrapper {
      min-height: 21.875rem;
      order: -1;
    }

    .about-block {
      margin-bottom: var(--px-32);
    }
  }
</style>
