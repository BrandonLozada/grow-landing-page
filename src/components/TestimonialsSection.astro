---
/*
  TODO (siguiente iteración):
  - Agregar fotos de clientes cuando estén disponibles
  - Mejorar diseño visual de las cards
  - Considerar agregar video testimonial
  - Nombres reales de personas/empresas cuando sean proporcionados
*/

const testimonials = [
  {
    id: 1,
    content:
      'Desde que trabajamos con GROW, la administración de nuestra nómina es mucho más eficiente. Su equipo siempre está disponible para resolver cualquier duda.',
    attribution: 'Cliente del sector industrial',
  },
  {
    id: 2,
    content:
      'Encontramos un aliado estratégico que nos ayudó a optimizar nuestros procesos administrativos y mantener el cumplimiento legal.',
    attribution: 'Empresa de servicios',
  },
  {
    id: 3,
    content:
      'La atención personalizada y el profesionalismo de GROW nos brindan la confianza que buscábamos para delegar procesos críticos.',
    attribution: 'Cliente del sector comercial',
  },
];
---

<section id="testimonios" class="testimonials">
    <div class="section-container">
        <span class="section-tag">TESTIMONIOS</span>
        <h2 class="section-title">Lo que dicen nuestros clientes.</h2>

        <div class="testimonials-grid">
            {testimonials.map((testimonial) => (
                <article class="testimonial-card">
                    <blockquote class="testimonial-content">
                        <p>"{testimonial.content}"</p>
                    </blockquote>
                    <footer class="testimonial-footer">
                        <cite class="testimonial-attribution">
                            — {testimonial.attribution}
                        </cite>
                    </footer>
                </article>
            ))}
        </div>
    </div>
</section>

<style>
    .testimonials-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--px-48);
    }

    .testimonial-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: var(--px-32);
        border-radius: var(--radius-lg);
        background-color: rgba(0, 0, 0, 0.03);
        height: 100%;
    }

    .testimonial-content {
        margin-bottom: var(--px-24);
    }

    .testimonial-content p {
        font-size: var(--text-lg);
        line-height: 1.7;
        font-style: italic;
    }

    .testimonial-footer {
        margin-top: auto;
    }

    .testimonial-attribution {
        font-size: var(--text-sm);
        font-style: normal;
        font-weight: 500;
        opacity: 0.7;
    }

    @media screen and (max-width: 64rem) {
        .testimonials-grid {
            gap: var(--px-32);
        }
    }

    @media screen and (max-width: 48rem) {
        .testimonials-grid {
            grid-template-columns: 1fr;
            gap: var(--px-24);
        }
    }
</style>
