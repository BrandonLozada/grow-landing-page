---
/*
  Sección: Problemas que resolvemos (Antes de GROW)
  - Muestra los desafíos operativos reales que enfrentan las empresas antes de contratar GROW.
  - Basado estrictamente en el contenido oficial proporcionado.
*/

const problems = [
  {
    title: 'Nómina manual',
    description: 'Procesos de nómina realizados manualmente con riesgo constante.',
  },
  {
    title: 'Errores y retrasos',
    description: 'Retrasos en pagos a colaboradores y errores de cálculo recurrentes.',
  },
  {
    title: 'Riesgo fiscal y laboral',
    description: 'Alto riesgo de incumplimiento ante autoridades fiscales y laborales.',
  },
  {
    title: 'Desatención jurídica',
    description: 'Falta de seguimiento legal, contratos desactualizados y vulnerabilidad jurídica.',
  },
  {
    title: 'Ineficiencia administrativa',
    description: 'Procesos administrativos lentos que frenan la productividad general.',
  },
  {
    title: 'Sobrecarga en RR.HH.',
    description: 'Sobrecarga de trabajo operativo para el departamento de Recursos Humanos.',
  },
  {
    title: 'Sobrecostos operativos',
    description: 'Incremento constante en costos operativos por errores e ineficiencias.',
  },
];
---

<section id="problemas" class="problems-section">
    <div class="section-container">
        <span class="section-tag">DESAFÍOS OPERATIVOS</span>
        <h2 class="section-title">Problemas que ayudamos a resolver.</h2>
        <p class="section-intro">
            Muchas empresas enfrentan obstáculos en sus procesos cotidianos que limitan su capacidad de crecimiento y generan riesgos innecesarios.
        </p>

        <div class="problems-grid">
            {problems.map((problem, index) => (
                <div class="problem-card">
                    <div class="problem-number">{String(index + 1).padStart(2, '0')}</div>
                    <div class="problem-content">
                        <h3 class="problem-title">{problem.title}</h3>
                        <p class="problem-description">{problem.description}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .problems-section {
        background-color: var(--color-background);
    }

    .section-intro {
        max-width: 40rem;
        margin-top: calc(-1 * var(--px-48));
        margin-bottom: var(--px-48);
        font-size: var(--text-lg);
        line-height: 1.6;
    }

    .problems-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
        gap: var(--px-24);
    }

    .problem-card {
        padding: var(--px-24);
        border-radius: var(--radius-lg);
        background-color: var(--color-white);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: var(--px-16);
        border: 1px solid rgba(0, 0, 0, 0.06);
    }

    .problem-number {
        font-size: var(--text-sm);
        font-weight: 700;
        opacity: 0.4;
        letter-spacing: 0.05em;
    }

    .problem-title {
        font-size: var(--text-lg);
        font-weight: 600;
        margin-bottom: var(--px-8);
        color: var(--color-text-primary);
    }

    .problem-description {
        font-size: var(--text-sm);
        line-height: 1.5;
        opacity: 0.8;
    }

    @media screen and (max-width: 48rem) {
        .problems-grid {
            grid-template-columns: 1fr;
            gap: var(--px-16);
        }
    }
</style>
