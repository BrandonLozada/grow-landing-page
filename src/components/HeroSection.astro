---
/* 
  TODO (siguiente iteración): 
  - Rediseñar el Hero con mayor impacto visual
  - Reemplazar imagen placeholder por imagen corporativa GROW
  - Agregar animaciones de entrada
  - Mejorar CTA con mayor contraste
*/
---

<section id="hero" class="hero">
    <div class="section-container hero-container">
        <div class="hero-content">
            <h1 class="hero-title">Servicios Especializados GROW</h1>
            <p class="hero-subtitle">
                Soluciones administrativas, contables y jurídicas que impulsan el crecimiento de tu empresa.
            </p>
            <p class="hero-description">
                En Servicios Especializados GROW ayudamos a las organizaciones a optimizar sus procesos administrativos mediante la gestión integral de nómina, servicios contables, asesoría jurídica y soluciones especializadas.
            </p>
            <p class="hero-description">
                Nos convertimos en un aliado estratégico para que nuestros clientes puedan enfocarse en hacer crecer su negocio mientras nosotros nos encargamos de la operación.
            </p>
            <div class="hero-cta">
                <a href="#contacto" class="btn btn--primary"
                    >SOLICITAR COTIZACIÓN</a
                >
                <a href="#servicios" class="btns--secondary">
                    <span class="btn--secondary btn--secondary-unhovered">
                        Conoce nuestros servicios
                    </span>
                    <span
                        class="btn--secondary btn--secondary-hovered"
                        aria-hidden="true"
                    >
                        Conoce nuestros servicios
                    </span>
                </a>
            </div>
        </div>
        <div class="hero-image-wrapper">
            <!-- Placeholder: imagen temporal. Reemplazar con imagen corporativa GROW en siguiente iteración. -->
            <img
                class="media"
                src="/hero-video-poster.webp"
                alt="Imagen representativa de servicios empresariales especializados"
                width="1080"
                height="720"
                loading="eager"
            />
        </div>
    </div>
</section>

<style>
    .hero {
        min-height: 100vh;
        padding-block: 6.688rem var(--px-56);
        display: flex;
        align-items: center;
    }

    .hero-container {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-64);
        align-items: center;
    }

    .hero-content {
        max-width: 37.5rem;
    }

    .hero-title {
        margin-bottom: var(--px-28);
        font-size: clamp(2.125rem, 6vw, var(--text-xxl));
        font-weight: 500;
        line-height: 1.2;
    }

    .hero-subtitle {
        font-size: clamp(var(--text-xl), 2vw, var(--text-2xl));
        margin-bottom: var(--px-24);
        line-height: 1.5;
    }

    .hero-description {
        font-size: var(--text-base);
        margin-bottom: var(--px-16);
        line-height: 1.6;
    }

    .hero-description:last-of-type {
        margin-bottom: var(--px-48);
    }

    .hero-cta {
        display: flex;
        gap: var(--px-16) var(--px-48);
        flex-wrap: wrap;
        align-items: center;
    }

    .btns--secondary {
        font-weight: 500;
        margin-top: 0.438rem;
        height: var(--px-36);
    }

    .btn--secondary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--px-8);
    }

    .hero-image-wrapper {
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    @media screen and (max-width: 64rem) {
        .hero-container {
            gap: var(--px-32);
        }

        .hero-content {
            max-width: 100%;
        }

        .hero-title {
            line-height: 1.3;
        }
    }

    @media screen and (max-width: 59.375rem) {
        .hero {
            min-height: auto;
        }

        .hero-container {
            grid-template-columns: 1fr;
            gap: var(--px-32);
        }

        .hero-title {
            margin-bottom: var(--px-24);
        }

        .hero-subtitle {
            margin-bottom: var(--px-16);
        }

        .hero-description:last-of-type {
            margin-bottom: var(--px-36);
        }

        .hero-cta {
            column-gap: var(--px-32);
        }

        .hero-image-wrapper {
            min-height: 18.75rem;
        }
    }
</style>
