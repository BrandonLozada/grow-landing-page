---
import { Image } from "astro:assets";
import heroImage from "/src/assets/images/hero.webp";
---

<section id="hero" class="hero">
    <div class="section-container">
        <!-- Bento Grid Hero Section -->
        <div class="bento-grid">
            <!-- Main Value Proposition Card -->
            <div class="bento-card hero-card">
                <div class="hero-blob"></div>
                <div class="hero-card-content">
                    <h1 class="hero-title">
                        Servicios Especializados <span>GROW</span>
                    </h1>
                    <p class="hero-subtitle">
                        Soluciones administrativas, contables y jurídicas que
                        impulsan el crecimiento de tu empresa.
                    </p>
                    <p class="hero-description">
                        En Servicios Especializados GROW ayudamos a las
                        organizaciones a optimizar sus procesos administrativos
                        mediante la gestión integral de nómina, servicios
                        contables, asesoría jurídica y soluciones
                        especializadas.
                    </p>
                    <p class="hero-description">
                        Nos convertimos en un aliado estratégico para que
                        nuestros clientes puedan enfocarse en hacer crecer su
                        negocio mientras nosotros nos encargamos de la
                        operación.
                    </p>
                    <div class="hero-cta">
                        <a href="#contacto" class="btn btn--primary"
                            >SOLICITAR COTIZACIÓN</a
                        >
                        <a href="#servicios" class="btns--secondary">
                            <span
                                class="btn--secondary btn--secondary-unhovered"
                            >
                                Conoce nuestros servicios
                            </span>
                            <span
                                class="btn--secondary btn--secondary-hovered"
                                aria-hidden="true"
                            >
                                Conoce nuestros servicios
                            </span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Image Cell -->
            <div class="bento-card image-card">
                <Image
                    class="media"
                    src={heroImage}
                    alt="Servicios Especializados GROW - Equipo corporativo"
                    width="1080"
                    height="720"
                    loading="eager"
                />
                <div class="image-overlay"></div>
                <div class="image-content">
                    <span class="image-badge">
                        <span class="image-badge-dot"></span> Equipo Experto
                    </span>
                    <p class="image-text">
                        Conviértenos en tu aliado estratégico.
                    </p>
                </div>
            </div>

            <!-- Core Services Small Cells -->
            <div class="bento-card bento-service-card">
                <div class="service-icon-wrapper" aria-hidden="true">
                    <svg
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        width="22"
                        height="22"
                    >
                        <path
                            d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4V8h16v10zm-6-5c0 1.66-1.34 3-3 3s-3-1.34-3-3 1.34-3 3-3 3 1.34 3 3z"
                        ></path>
                    </svg>
                </div>
                <div>
                    <h3 class="service-title">Nómina</h3>
                    <p class="service-desc">
                        Gestión integral y precisa de nómina.
                    </p>
                </div>
            </div>

            <div class="bento-card bento-service-card">
                <div class="service-icon-wrapper" aria-hidden="true">
                    <svg
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        width="22"
                        height="22"
                    >
                        <path d="M4 10h16v2H4zm0-4h16v2H4zm0 8h16v2H4z"></path>
                    </svg>
                </div>
                <div>
                    <h3 class="service-title">Servicios Contables</h3>
                    <p class="service-desc">
                        Control financiero y cumplimiento fiscal.
                    </p>
                </div>
            </div>

            <div class="bento-card bento-service-card">
                <div class="service-icon-wrapper" aria-hidden="true">
                    <svg
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        width="22"
                        height="22"
                    >
                        <path
                            d="M12 2L1 21h22L12 2zm0 3.99L19.53 19H4.47L12 5.99zM11 16h2v2h-2zm0-6h2v4h-2z"
                        ></path>
                    </svg>
                </div>
                <div>
                    <h3 class="service-title">Servicios Jurídicos</h3>
                    <p class="service-desc">
                        Asesoría y representación especializada.
                    </p>
                </div>
            </div>

            <div class="bento-card bento-service-card">
                <div class="service-icon-wrapper" aria-hidden="true">
                    <svg
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        width="22"
                        height="22"
                    >
                        <path
                            d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-5.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"
                        ></path>
                    </svg>
                </div>
                <div>
                    <h3 class="service-title">Cumplimiento</h3>
                    <p class="service-desc">
                        Alineación normativa garantizada.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .hero {
        padding-block: calc(var(--h-menu-bar) + 2rem) var(--px-64);
        background-color: var(--color-background, #f1f1f1);
    }

    .bento-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--px-24);
    }

    @media (min-width: 48rem) {
        .bento-grid {
            grid-template-columns: repeat(12, 1fr);
            gap: var(--px-24);
        }
    }

    .bento-card {
        border-radius: var(--radius-lg, 1rem);
        transition:
            transform var(--transition-short),
            box-shadow var(--transition-short);
        position: relative;
        overflow: hidden;
        box-sizing: border-box;
    }

    /* Hero Card */
    .hero-card {
        background-color: var(--color-white, #ffffff);
        border: 1px solid rgba(0, 0, 0, 0.08);
        padding: var(--px-40);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    @media (min-width: 48rem) {
        .hero-card {
            grid-column: span 12;
        }
    }

    @media (min-width: 64rem) {
        .hero-card {
            grid-column: span 8;
            grid-row: span 2;
            min-height: 34rem;
        }
    }

    .hero-blob {
        position: absolute;
        top: -6rem;
        right: -6rem;
        width: 24rem;
        height: 24rem;
        background-color: rgba(0, 0, 0, 0.03);
        border-radius: 50%;
        filter: blur(48px);
        pointer-events: none;
    }

    .hero-card-content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
    }

    .hero-title {
        margin-bottom: var(--px-20);
        font-size: clamp(2rem, 4vw, 3.25rem);
        font-weight: 500;
        line-height: 1.2;
        color: var(--color-text-primary);
    }

    .hero-subtitle {
        font-size: var(--text-xl);
        font-weight: 500;
        line-height: 1.4;
        margin-bottom: var(--px-20);
        color: var(--color-text-primary);
    }

    .hero-description {
        font-size: var(--text-base);
        line-height: 1.6;
        opacity: 0.8;
        margin-bottom: var(--px-16);
    }

    .hero-description:last-of-type {
        margin-bottom: var(--px-32);
    }

    .hero-cta {
        display: flex;
        gap: var(--px-16) var(--px-32);
        flex-wrap: wrap;
        align-items: center;
    }

    .btns--secondary {
        font-weight: 500;
        height: var(--px-36);
        display: flex;
        align-items: center;
    }

    .btn--secondary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--px-8);
    }

    /* Image Card */
    .image-card {
        min-height: 20rem;
    }

    @media (min-width: 48rem) {
        .image-card {
            grid-column: span 12;
            min-height: 22rem;
        }
    }

    @media (min-width: 64rem) {
        .image-card {
            grid-column: span 4;
            grid-row: span 2;
            min-height: auto;
        }
    }

    .image-card img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s ease;
    }

    .image-card:hover img {
        transform: scale(1.05);
    }

    .image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.65), transparent);
    }

    .image-content {
        position: absolute;
        bottom: var(--px-24);
        left: var(--px-24);
        right: var(--px-24);
        z-index: 2;
    }

    .image-badge {
        display: inline-flex;
        align-items: center;
        gap: var(--px-8);
        background-color: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        padding: var(--px-6) var(--px-16);
        border-radius: 9999px;
        color: #ffffff;
        font-size: var(--text-xs);
        margin-bottom: var(--px-8);
    }

    .image-badge-dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background-color: #34d399;
    }

    .image-text {
        color: #ffffff;
        font-weight: 500;
        font-size: var(--text-base);
        margin: 0;
    }

    /* Core Service Small Cards */
    .bento-service-card {
        background-color: var(--color-white, #ffffff);
        border: 1px solid rgba(0, 0, 0, 0.08);
        padding: var(--px-24);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: var(--px-16);
    }

    @media (min-width: 48rem) {
        .bento-service-card {
            grid-column: span 6;
        }
    }

    @media (min-width: 64rem) {
        .bento-service-card {
            grid-column: span 3;
        }
    }

    @media (hover: hover) and (pointer: fine) {
        .bento-service-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        }
    }

    .service-icon-wrapper {
        width: var(--px-44);
        height: var(--px-44);
        background-color: rgba(0, 0, 0, 0.05);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-primary);
    }

    .service-title {
        font-size: var(--text-base);
        font-weight: 600;
        margin: 0 0 var(--px-6) 0;
        color: var(--color-text-primary);
    }

    .service-desc {
        font-size: var(--text-xs);
        line-height: 1.5;
        opacity: 0.75;
        margin: 0;
    }

    @media screen and (max-width: 48rem) {
        .hero-card {
            padding: var(--px-24);
        }
    }
</style>
