---
/* 
  [TEMPORAL / PLACEHOLDER]
  - La imagen actual es un asset temporal proveniente de la plantilla original.
  - Se actualizará en la Iteración 3 por una fotografía corporativa definitiva de Servicios Especializados GROW.
*/
---

<section id="hero" class="hero">
    <div class="section-container hero-container">
        <div class="hero-content">
            <span class="hero-badge">SOLUCIONES INTEGRALES GROW</span>
            <h1 class="hero-title">
                Servicios Especializados <span class="gradient-text">GROW</span>
            </h1>
            <p class="hero-subtitle">
                Soluciones administrativas, contables y jurídicas que impulsan el crecimiento de tu empresa.
            </p>
            <p class="hero-description">
                En Servicios Especializados GROW ayudamos a las organizaciones a optimizar sus procesos administrativos mediante la gestión integral de nómina, servicios contables, asesoría jurídica y soluciones especializadas.
            </p>
            <p class="hero-description">
                Nos convertimos en un aliado estratégico para que nuestros clientes puedan enfocarse en hacer crecer su negocio mientras nosotros nos encargamos de la operación.
            </p>
            <div class="hero-cta">
                <a href="#contacto" class="btn btn--primary"
                    >SOLICITAR COTIZACIÓN</a
                >
                <a href="#servicios" class="btns--secondary">
                    <span class="btn--secondary btn--secondary-unhovered">
                        Conoce nuestros servicios
                    </span>
                    <span
                        class="btn--secondary btn--secondary-hovered"
                        aria-hidden="true"
                    >
                        Conoce nuestros servicios
                    </span>
                </a>
            </div>
        </div>
        <div class="hero-image-wrapper">
            <!-- Placeholder: imagen temporal. Reemplazar con fotografía corporativa GROW. -->
            <img
                class="media"
                src="/hero-video-poster.webp"
                alt="Servicios Especializados GROW - Soluciones empresariales"
                width="1080"
                height="720"
                loading="eager"
            />
        </div>
    </div>
</section>

<style>
    .hero {
        min-height: 100vh;
        padding-block: 6.688rem var(--px-56);
        display: flex;
        align-items: center;
        background: linear-gradient(180deg, rgba(90, 169, 240, 0.05) 0%, rgba(42, 125, 225, 0.02) 100%);
    }

    .hero-container {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-64);
        align-items: center;
    }

    .hero-content {
        max-width: 37.5rem;
    }

    .hero-badge {
        display: inline-block;
        font-size: var(--text-xs);
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--color-blue-main);
        background-color: rgba(42, 125, 225, 0.08);
        padding: var(--px-6) var(--px-16);
        border-radius: var(--radius-full);
        margin-bottom: var(--px-16);
    }

    .hero-title {
        margin-bottom: var(--px-24);
        font-size: clamp(2.125rem, 5.5vw, var(--text-xxl));
        font-weight: 700;
        line-height: 1.15;
    }

    .gradient-text {
        background: var(--gradient-hero);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
        font-size: clamp(var(--text-xl), 2vw, var(--text-2xl));
        margin-bottom: var(--px-24);
        line-height: 1.45;
        font-weight: 600;
        color: var(--color-text-primary);
    }

    .hero-description {
        font-size: var(--text-base);
        margin-bottom: var(--px-16);
        line-height: 1.6;
        opacity: 0.85;
    }

    .hero-description:last-of-type {
        margin-bottom: var(--px-40);
    }

    .hero-cta {
        display: flex;
        gap: var(--px-16) var(--px-32);
        flex-wrap: wrap;
        align-items: center;
    }

    .btns--secondary {
        font-weight: 600;
        margin-top: 0.438rem;
        height: var(--px-36);
    }

    .btn--secondary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--px-8);
    }

    .hero-image-wrapper {
        width: 100%;
        height: 100%;
        overflow: hidden;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        border: 1px solid rgba(42, 125, 225, 0.12);
    }

    @media screen and (max-width: 64rem) {
        .hero-container {
            gap: var(--px-32);
        }

        .hero-content {
            max-width: 100%;
        }

        .hero-title {
            line-height: 1.2;
        }
    }

    @media screen and (max-width: 59.375rem) {
        .hero {
            min-height: auto;
        }

        .hero-container {
            grid-template-columns: 1fr;
            gap: var(--px-32);
        }

        .hero-title {
            margin-bottom: var(--px-20);
        }

        .hero-subtitle {
            margin-bottom: var(--px-16);
        }

        .hero-description:last-of-type {
            margin-bottom: var(--px-32);
        }

        .hero-cta {
            column-gap: var(--px-24);
        }

        .hero-image-wrapper {
            min-height: 18.75rem;
        }
    }
</style>
