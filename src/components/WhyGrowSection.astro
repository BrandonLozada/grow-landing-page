---
/*
  Sección: ¿Por qué elegir GROW? (Diferenciadores comerciales)
  - Destaca los pilares fundamentales que diferencian el servicio de GROW.
  - Estilo limpio y neutral basado en la plantilla base.
*/

const differentiators = [
  {
    id: "medida",
    title: "Soluciones a tu medida",
    text: "Diseñamos esquemas adaptados a las necesidades particulares de cada organización, sin fórmulas genéricas.",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="diff-icon"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`,
  },
  {
    id: "cercano",
    title: "Servicio cercano y confiable",
    text: "Brindamos una atención personal y directa, construyendo relaciones de confianza a largo plazo.",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="diff-icon"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    id: "resultados",
    title: "Enfoque en resultados",
    text: "Orientados a generar una mayor eficiencia operativa y optimización real de recursos en tu negocio.",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="diff-icon"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>`,
  },
  {
    id: "cumplimiento",
    title: "Tranquilidad y cumplimiento",
    text: "Aseguramos procesos eficientes y estricto cumplimiento normativo fiscal, laboral y legal.",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="diff-icon"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>`,
  },
];
---

<section id="por-que-grow" class="why-grow-section">
  <div class="section-container">
    <div class="why-grow-header">
      <span class="section-tag">DIFERENCIADORES</span>
      <h2 class="section-title">¿Por qué elegir GROW?</h2>

      <div class="why-grow-intro-grid">
        <div class="why-grow-main-text">
          En GROW entendemos que cada empresa enfrenta desafíos distintos. Por
          ello diseñamos soluciones adaptadas a las necesidades de cada cliente,
          ofreciendo un servicio cercano, confiable y orientado a resultados.
        </div>
        <div class="intro-quote-card">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="quote-icon"
            aria-hidden="true"
          >
            <defs>
              <linearGradient
                id="quoteGradient"
                x1="0%"
                y1="0%"
                x2="100%"
                y2="100%"
              >
                <stop offset="0%" stop-color="rgba(15,23,42,.1)"></stop>
                <stop offset="40%" stop-color="rgba(67,106,143,.397)"></stop>
                <stop offset="100%" stop-color="rgba(204,48,183,.452)"></stop>
              </linearGradient>
            </defs>

            <path
              fill="url(#quoteGradient)"
              d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"
            ></path>
          </svg>
          <p class="quote-text">
            "Nuestra prioridad es brindar tranquilidad a nuestros clientes
            mediante procesos eficientes, cumplimiento normativo y atención
            personalizada."
          </p>
        </div>
      </div>
    </div>

    <div class="differentiators-grid">
      {
        differentiators.map((diff) => (
          <div class="diff-card">
            <div class="diff-icon-badge" aria-hidden="true">
              <Fragment set:html={diff.svg} />
            </div>
            <h3 class="diff-title">{diff.title}</h3>
            <p class="diff-text">{diff.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why-grow-section {
    background-color: var(--color-white);
  }

  .why-grow-header {
    width: 100%;
    margin-bottom: var(--px-48);
  }

  .why-grow-header .section-title {
    margin-bottom: var(--px-24);
  }

  .why-grow-intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px-32);
    align-items: start;
    margin-top: 0;
  }

  .why-grow-main-text {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-dark);
    opacity: 0.8;
  }

  .intro-quote-card {
    padding: var(--px-24);
    border-radius: var(--radius-lg);
    background-color: rgba(255, 255, 255, 0.719);
    color: #000000;
    display: flex;
    gap: var(--px-16);
    align-items: flex-start;
  }

  .quote-icon {
    width: var(--px-32);
    height: var(--px-32);
    flex-shrink: 0;
    opacity: 0.6;
  }

  .quote-text {
    font-size: var(--text-base);
    line-height: 1.5;
    font-style: italic;
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0;
  }

  .differentiators-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--px-24);
  }

  .diff-card {
    padding: var(--px-28);
    border-radius: var(--radius-lg);
    cursor: default;
    background-color: rgba(255, 255, 255, 0.719);
    color: #000000;
    display: flex;
    flex-direction: column;
    gap: var(--px-16);
    transition:
      transform var(--transition-short),
      box-shadow var(--transition-short);
  }

  .diff-icon-badge {
    width: var(--px-40);
    height: var(--px-40);
    background: linear-gradient(
      135deg,
      rgba(15, 23, 42, 0.1) 0%,
      rgba(67, 106, 143, 0.397) 40%,
      rgba(204, 48, 183, 0.452) 100%
    );
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .diff-icon-badge :global(.diff-icon) {
    width: var(--px-20);
    height: var(--px-20);
  }

  .diff-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .diff-text {
    font-size: var(--text-sm);
    line-height: 1.5;
    opacity: 0.8;
  }

  @media (hover: hover) and (pointer: fine) {
    .diff-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    }
  }

  @media screen and (max-width: 64rem) {
    .why-grow-intro-grid {
      grid-template-columns: 1fr;
      gap: var(--px-24);
    }

    .differentiators-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--px-20);
    }
  }

  @media screen and (max-width: 36rem) {
    .differentiators-grid {
      grid-template-columns: 1fr;
      gap: var(--px-16);
    }
  }
</style>
