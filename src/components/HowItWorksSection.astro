---
import { Image } from "astro:assets";
import howItWorksImage1 from "/src/assets/images/how-it-works-1.webp";
import howItWorksImage2 from "/src/assets/images/how-it-works-2.webp";
import howItWorksImage3 from "/src/assets/images/how-it-works-3.webp";
import howItWorksImage4 from "/src/assets/images/how-it-works-4.webp";

const processSteps = [
    {
        step: "01",
        title: "Conocemos las necesidades de tu empresa",
        description:
            "Iniciamos con una atención personalizada para identificar los desafíos específicos en materia administrativa, contable o jurídica que enfrenta tu organización.",
        image: howItWorksImage1,
    },
    {
        step: "02",
        title: "Adaptamos la solución a tu medida",
        description:
            "Diseñamos un plan de trabajo adaptado a los requerimientos y dimensiones de tu empresa, garantizando soluciones cercanas, eficientes y orientadas a resultados.",
        image: howItWorksImage2,
    },
    {
        step: "03",
        title: "Nos encargamos de la operación",
        description:
            "Ejecutamos la gestión integral de tu nómina, procesos contables o aspectos legales con puntualidad, orden y estricto cumplimiento normativo.",
        image: howItWorksImage3,
    },
    {
        step: "04",
        title: "Acompañamiento continuo y crecimiento",
        description:
            "Brindamos asesoría permanente y seguimiento cercano, convirtiéndonos en tu aliado estratégico para que puedas enfocarte en hacer crecer tu negocio.",
        image: howItWorksImage4,
    },
];
---

<section id="proceso" class="process-section">
    <div class="section-container">
        <div class="process-header">
            <span class="section-tag">NUESTRO PROCESO</span>
            <h2 class="section-title">¿Cómo trabajamos con tu empresa?</h2>
            <p class="process-intro">
                Un esquema de trabajo transparente y orientado a la eficiencia
                operacional y tranquilidad de nuestros clientes.
            </p>
        </div>

        <div class="process-grid">
            {
                processSteps.map((step) => (
                    <div class="process-card">
                        <div class="process-img-container">
                            <Image
                                src={step.image}
                                alt={step.title}
                                class="process-img"
                                loading="lazy"
                                width="400"
                                height="300"
                            />
                            <div class="process-overlay">
                                <p class="process-desc">{step.description}</p>
                            </div>
                        </div>
                        <div class="process-title-container">
                            <span class="process-num">{step.step}</span>
                            <h3 class="process-card-title">{step.title}</h3>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .process-section {
        background-color: var(--color-background, #f1f1f1);
    }

    .process-header {
        max-width: 42rem;
        margin-bottom: var(--px-48);
    }

    .process-header .section-title {
        margin-bottom: var(--px-16);
    }

    .process-intro {
        font-size: var(--text-lg);
        line-height: 1.6;
        opacity: 0.8;
        margin: 0;
    }

    .process-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--px-24);
        padding-top: var(--px-32);
    }

    @media (min-width: 48rem) {
        .process-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 64rem) {
        .process-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    .process-card {
        display: flex;
        flex-direction: column;
        cursor: pointer;
        position: relative;
    }

    .process-img-container {
        border-radius: var(--radius-lg, 1.5rem);
        overflow: hidden;
        position: relative;
        height: 18rem;
        width: 100%;
        margin-bottom: var(--px-24);
        background-color: var(--color-secondary, #222222);
    }

    .process-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s ease-in-out;
    }

    .process-card:hover .process-img {
        transform: scale(1.1);
    }

    .process-overlay {
        position: absolute;
        inset: 0;
        background-color: rgba(17, 17, 17, 0.85);
        opacity: 0;
        transition: opacity 0.5s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--px-24);
    }

    .process-card:hover .process-overlay {
        opacity: 1;
    }

    .process-desc {
        color: #ffffff;
        text-align: center;
        font-size: var(--text-sm);
        line-height: 1.6;
        transform: translateY(1rem);
        transition: transform 0.5s ease;
        margin: 0;
    }

    .process-card:hover .process-desc {
        transform: translateY(0);
    }

    .process-title-container {
        display: flex;
        align-items: flex-start;
        gap: var(--px-16);
        transition:
            transform 0.3s ease,
            color 0.3s ease;
    }

    .process-card:hover .process-title-container {
        transform: translateY(-0.35rem);
    }

    .process-num {
        font-size: var(--text-3xl);
        font-weight: 700;
        line-height: 1;
        color: var(--color-text-primary);
        transition: color 0.3s ease;
    }

    .process-card-title {
        font-weight: 500;
        font-size: var(--text-base);
        line-height: 1.3;
        margin-top: 0.15rem;
        color: var(--color-text-primary);
        transition: color 0.3s ease;
    }
</style>
