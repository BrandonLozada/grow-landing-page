---
/*
  Sección: ¿Cómo trabajamos? (Proceso de trabajo GROW)
  - Basado exclusivamente en el modelo conceptual respaldado por el contenido de GROW:
    Atención personalizada -> Adaptación -> Gestión de operación -> Acompañamiento estratégico.
*/

const processSteps = [
    {
        step: "01",
        title: "Conocemos las necesidades de tu empresa",
        description:
            "Iniciamos con una atención personalizada para identificar los desafíos específicos en materia administrativa, contable o jurídica que enfrenta tu organización.",
    },
    {
        step: "02",
        title: "Adaptamos la solución a tu medida",
        description:
            "Diseñamos un plan de trabajo adaptado a los requerimientos y dimensiones de tu empresa, garantizando soluciones cercanas, eficientes y orientadas a resultados.",
    },
    {
        step: "03",
        title: "Nos encargamos de la operación",
        description:
            "Ejecutamos la gestión integral de tu nómina, procesos contables o aspectos legales con puntualidad, orden y estricto cumplimiento normativo.",
    },
    {
        step: "04",
        title: "Acompañamiento continuo y crecimiento",
        description:
            "Brindamos asesoría permanente y seguimiento cercano, convirtiéndonos en tu aliado estratégico para que puedas enfocarte en hacer crecer tu negocio.",
    },
];
---

<section id="proceso" class="process-section">
    <div class="section-container">
        <div class="process-header">
            <span class="section-tag">NUESTRO PROCESO</span>
            <h2 class="section-title">¿Cómo trabajamos con tu empresa?</h2>
            <p class="process-subtitle-text">
                Un esquema de trabajo transparente y orientado a la eficiencia
                operacional y tranquilidad de nuestros clientes.
            </p>
        </div>

        <div class="process-grid">
            {
                processSteps.map((step) => (
                    <div class="process-card">
                        <div class="step-header">
                            <span class="step-number">{step.step}</span>
                        </div>
                        <div class="step-content">
                            <h3 class="step-title">{step.title}</h3>
                            <p class="step-description">{step.description}</p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .process-section {
        background-color: #f8fafc;
    }

    .process-header {
        max-width: 42rem;
        margin-bottom: var(--px-48);
    }

    .process-header .section-title {
        margin-bottom: var(--px-16);
    }

    .process-subtitle-text {
        font-size: var(--text-lg);
        line-height: 1.6;
        margin-top: 0;
        margin-bottom: 0;
        opacity: 0.85;
    }

    .process-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--px-24);
    }

    .process-card {
        padding: var(--px-28);
        border-radius: var(--radius-lg);
        background-color: var(--color-white);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: var(--px-20);
        border: 1px solid rgba(122, 122, 122, 0.15);
        transition:
            transform var(--transition-short),
            box-shadow var(--transition-short),
            border-color var(--transition-short);
    }

    .step-number {
        font-size: var(--text-3xl);
        font-weight: 800;
        background: var(--gradient-hero);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: 0.05em;
    }

    .step-title {
        font-size: var(--text-lg);
        font-weight: 600;
        margin-bottom: var(--px-12);
        color: var(--color-text-primary);
        line-height: 1.35;
    }

    .step-description {
        font-size: var(--text-sm);
        line-height: 1.5;
        opacity: 0.8;
    }

    @media (hover: hover) and (pointer: fine) {
        .process-card:hover {
            transform: translateY(-3px);
            border-color: var(--color-blue-main);
            box-shadow: 0 8px 20px rgba(42, 125, 225, 0.1);
        }
    }

    @media screen and (max-width: 64rem) {
        .process-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: var(--px-20);
        }
    }

    @media screen and (max-width: 36rem) {
        .process-grid {
            grid-template-columns: 1fr;
            gap: var(--px-16);
        }
    }
</style>
