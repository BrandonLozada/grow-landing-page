---
import { SITE } from "@consts";
---

<section id="contacto" class="contact">
  <div class="section-container contact-container">
    <div class="contact-top">
      <div class="contact-top-left contact-header">
        <span class="section-tag">CONTACTO</span>
        <h2 class="section-title">
          ¿Listo para optimizar la administración de tu empresa?
        </h2>
        <p class="contact-cta-text">
          Nuestro equipo está preparado para ayudarte. Contáctanos y descubre
          cómo podemos convertirnos en el aliado estratégico que tu organización
          necesita.
        </p>
      </div>

      <address class="contact-top-right contact-info">
        <div>
          <div class="contact-icon">
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill-rule="evenodd"
              clip-rule="evenodd"
            >
              <path
                d="M24 21h-24v-18h24v18zm-23-16.477v15.477h22v-15.477l-10.999 10-11.001-10zm21.089-.523h-20.176l10.088 9.171 10.088-9.171z"
              ></path>
            </svg>
            <div class="contact-icon-s">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm3.445 17.827c-3.684 1.684-9.401-9.43-5.8-11.308l1.053-.519 1.746 3.409-1.042.513c-1.095.587 1.185 5.04 2.305 4.497l1.032-.505 1.76 3.397-1.054.516z"
                ></path>
              </svg>
            </div>
          </div>
          <h3 class="contact-subtitle">Escríbenos</h3>
          <div class="contact-details">
            <a
              href={`mailto:${SITE.EMAIL}`}
              class="contact-detail contact-email">{SITE.EMAIL}</a
            >
            <a
              href={`tel:${SITE.TELEPHONE.replace(/\s|\(|\)/g, "")}`}
              class="contact-detail contact-phone">{SITE.TELEPHONE}</a
            >
            <p class="contact-detail contact-provisional">
              <small>Datos de contacto.</small>
            </p>
          </div>
        </div>
        <div>
          <div class="contact-icon">
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill-rule="evenodd"
              clip-rule="evenodd"
            >
              <path
                d="M12 10c-1.104 0-2-.896-2-2s.896-2 2-2 2 .896 2 2-.896 2-2 2m0-5c-1.657 0-3 1.343-3 3s1.343 3 3 3 3-1.343 3-3-1.343-3-3-3m-7 2.602c0-3.517 3.271-6.602 7-6.602s7 3.085 7 6.602c0 3.455-2.563 7.543-7 14.527-4.489-7.073-7-11.072-7-14.527m7-7.602c-4.198 0-8 3.403-8 7.602 0 4.198 3.469 9.21 8 16.398 4.531-7.188 8-12.2 8-16.398 0-4.199-3.801-7.602-8-7.602"
              ></path>
            </svg>
          </div>
          <h3 class="contact-subtitle">Ubicación</h3>
          <p class="contact-detail contact-location-name">
            Servicios Especializados GROW
          </p>
          <p class="contact-detail">Calle Torreón No. 1719, Interior 11</p>
          <p class="contact-detail">Colonia Mitras Centro, C.P. 64460</p>
          <p class="contact-detail">Monterrey, Nuevo León, México.</p>
          <p class="contact-detail contact-reference">
            <small>Entre C. Peñón Blanco y Av. Matehuala.</small>
          </p>
        </div>
      </address>
    </div>
    <div class="contact-bottom">
      <form class="contact-form" id="contact-form" novalidate>
        <!-- Campo trampa Honeypot (Oculto para humanos, visible para bots de spam) -->
        <div class="form-hp" aria-hidden="true" style="display: none !important;">
          <label for="website_hp">Si eres humano, deja este campo vacío</label>
          <input
            type="text"
            id="website_hp"
            name="website_hp"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div class="contact-form-fields">
          <div class="form-group">
            <label class="form-label" for="name">
              Nombre <span class="required-asterisk" aria-hidden="true">*</span>
            </label>
            <input
              class="form-input"
              id="name"
              name="name"
              type="text"
              placeholder="Ingresa tu nombre completo"
              required
              autocomplete="name"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="company">Empresa <small class="optional-label">(opcional)</small></label>
            <input
              class="form-input"
              id="company"
              name="company"
              type="text"
              placeholder="Nombre de tu empresa"
              autocomplete="organization"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="email">
              Correo electrónico <span class="required-asterisk" aria-hidden="true">*</span>
            </label>
            <input
              class="form-input"
              id="email"
              name="email"
              type="email"
              placeholder="ejemplo@empresa.com"
              required
              autocomplete="email"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="phone">Teléfono <small class="optional-label">(opcional)</small></label>
            <input
              class="form-input"
              id="phone"
              name="phone"
              type="tel"
              placeholder="81 1234 5678"
              autocomplete="tel"
            />
          </div>

          <div class="form-group message-group">
            <label class="form-label" for="message">
              Mensaje <span class="required-asterisk" aria-hidden="true">*</span>
            </label>
            <textarea
              class="form-input form-textarea"
              id="message"
              name="message"
              placeholder="Escribe tu mensaje o consulta aquí..."
              rows="4"
              required></textarea>
          </div>
        </div>

        <div class="form-submit">
          <button type="submit" id="submit-btn" class="btn btn--primary">
            ENVIAR MENSAJE
          </button>
          <div class="contact-terms">
            <span class="contact-terms-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                aria-hidden="true"
                ><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"
                ></path><path d="M12 8h.01"></path></svg
              >
            </span>
            Los campos con (*) son obligatorios. Al enviar aceptas los
            <a class="text-link" href="legal/terms">Términos y Condiciones</a> y la
            <a class="text-link" href="legal/privacy">Política de Privacidad</a>.
          </div>
        </div>

        <!-- Notificaciones de Accesibilidad (ARIA Live Regions) -->
        <div
          id="form-feedback-success"
          class="form-feedback form-feedback--success"
          role="status"
          aria-live="polite"
          hidden
        >
          <p id="success-text">¡Gracias! Tu mensaje ha sido enviado correctamente.</p>
        </div>

        <div
          id="form-feedback-error"
          class="form-feedback form-feedback--error"
          role="alert"
          aria-live="assertive"
          hidden
        >
          <p id="error-text">Ocurrió un error al enviar el mensaje. Por favor intenta de nuevo.</p>
        </div>
      </form>

      <div class="contact-map">
        <iframe
          src="https://www.google.com/maps?q=25.7004388,-100.3457594&z=18&output=embed"
          title="Mapa de ubicación de Servicios Especializados GROW en Monterrey, Nuevo León"
          width="600"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    overflow-x: hidden;
  }

  .section-container.contact-container {
    display: grid;
    grid-template-rows: auto auto;
    width: 100%;
  }

  .contact-top,
  .contact-bottom {
    gap: var(--px-32);
  }

  .contact-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .contact-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .contact-header .section-title {
    margin-bottom: var(--px-16);
  }

  .contact-top-left,
  .contact-form {
    margin-right: var(--px-48);
  }

  .contact-cta-text {
    margin-top: 0;
    margin-bottom: var(--px-32);
    line-height: 1.6;
    font-size: var(--text-lg);
    opacity: 0.85;
  }

  .contact-form-fields {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--px-24);
    margin-bottom: var(--px-40);
  }

  .form-group {
    display: grid;
    gap: var(--px-8);
  }

  .form-label {
    font-size: var(--px-18);
    font-weight: 500;
  }

  .required-asterisk {
    color: #dc2626;
  }

  .optional-label {
    font-weight: 400;
    font-size: var(--text-xs);
    opacity: 0.7;
    margin-left: var(--px-4);
  }

  .form-input {
    color: var(--color-text-primary);
    padding: var(--px-16) var(--px-20);
    box-shadow: none;
    border: 1px solid rgba(0, 0, 0, 0.183);
    transition: all var(--transition-short);
    font-size: var(--text-sm);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    border-radius: var(--radius-sm, 4px);
  }

  .form-input:focus {
    color: var(--color-primary);
    border-color: rgba(0, 0, 0, 0.7);
    box-shadow: 0 0 3px rgba(0, 0, 0, 0.3);
    outline: none;
  }

  .form-input--error {
    border-color: #dc2626 !important;
    background-color: #fef2f2;
  }

  .form-group.message-group {
    grid-column: 1 / -1;
  }

  .contact-info {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--px-24);
    font-style: normal;
    margin-bottom: var(--px-56);
  }

  .contact-info > div {
    position: relative;
    padding-left: var(--px-24);
  }

  .contact-info > div::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 1px;
    background-color: rgba(0, 0, 0, 0.1);
  }

  .form-submit {
    display: flex;
    gap: var(--px-16);
    align-items: center;
    justify-content: space-between;
  }

  .form-feedback {
    margin-top: var(--px-24);
    padding: var(--px-16);
    border-radius: var(--radius-sm, 4px);
    font-weight: 500;
    font-size: var(--text-sm);
    animation: fadeIn 0.3s ease-in-out;
  }

  .form-feedback p {
    margin: 0;
  }

  .form-feedback--success {
    background-color: #f0fdf4;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  .form-feedback--error {
    background-color: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .contact-terms {
    font-size: var(--text-xs);
    max-width: 18.75rem;
  }

  .contact-terms-icon svg {
    display: inline;
    width: var(--text-base);
    margin-bottom: var(--px-2);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contact-subtitle {
    font-size: var(--text-xl);
    margin-bottom: var(--px-12);
    font-weight: 500;
  }

  .contact-detail {
    display: block;
    opacity: 0.8;
    font-size: var(--text-sm);
    transition: opacity var(--transition-short);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  a.contact-detail:active {
    opacity: 1;
  }

  .contact-email {
    margin-bottom: var(--px-6);
  }

  .contact-provisional {
    margin-top: var(--px-8);
    opacity: 0.5;
  }

  .contact-location-name {
    font-weight: 500;
    margin-bottom: var(--px-4);
  }

  .contact-reference {
    margin-top: var(--px-8);
    opacity: 0.6;
  }

  .contact-icon {
    position: relative;
    display: inline-grid;
    margin-bottom: 1.375rem;
  }

  .contact-icon svg:first-of-type {
    width: var(--px-48);
  }

  .contact-icon-s {
    position: absolute;
    display: grid;
    top: -15%;
    right: -55%;
  }

  .contact-map {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .contact-map iframe {
    width: 100%;
    height: 100%;
    min-height: 28.125rem;
  }

  @media (hover: hover) and (pointer: fine) {
    a.contact-detail:hover {
      opacity: 1;
    }

    .form-input:hover {
      border-color: rgba(0, 0, 0, 0.38);
    }
  }

  @media (max-width: 72.5rem) {
    .contact-form {
      margin-right: 0;
    }
  }

  @media (max-width: 66.5rem) {
    .contact-top {
      grid-template-columns: 1fr;
    }

    .contact-form-fields {
      grid-template-columns: 1fr;
    }

    .form-submit {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 48rem) {
    .contact-bottom {
      grid-template-columns: 1fr;
    }

    .form-submit {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--px-16);
    }

    .contact-terms {
      max-width: 100%;
    }

    .contact-map iframe {
      min-height: 18.75rem;
    }
  }

  @media (max-width: 35rem) {
    .contact-info {
      grid-template-columns: 1fr;
      gap: var(--px-32);
    }

    .contact-info > div {
      padding-left: var(--px-16);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
    const successFeedback = document.getElementById("form-feedback-success");
    const errorFeedback = document.getElementById("form-feedback-error");
    const successText = document.getElementById("success-text");
    const errorText = document.getElementById("error-text");

    if (!form || !submitBtn || !successFeedback || !errorFeedback || !successText || !errorText) {
      return;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Limpiar errores visuales previos
      successFeedback.hidden = true;
      errorFeedback.hidden = true;
      form.querySelectorAll(".form-input--error").forEach((el) => {
        el.classList.remove("form-input--error");
      });

      // Extraer datos del formulario
      const formData = new FormData(form);
      const payload = {
        name: (formData.get("name") as string || "").trim(),
        company: (formData.get("company") as string || "").trim(),
        email: (formData.get("email") as string || "").trim(),
        phone: (formData.get("phone") as string || "").trim(),
        message: (formData.get("message") as string || "").trim(),
        website_hp: (formData.get("website_hp") as string || "").trim(),
      };

      // Estado de carga UI
      const originalBtnText = submitBtn.textContent || "ENVIAR MENSAJE";
      submitBtn.disabled = true;
      submitBtn.setAttribute("aria-busy", "true");
      submitBtn.textContent = "ENVIANDO...";

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          successText.textContent = result.message || "¡Gracias! Tu mensaje ha sido enviado exitosamente.";
          successFeedback.hidden = false;
          form.reset();

          // Ocultar mensaje de éxito tras 6 segundos
          setTimeout(() => {
            successFeedback.hidden = true;
          }, 6000);
        } else {
          // Destacar campos erróneos si la API devuelve objeto de errores
          if (result.errors) {
            Object.keys(result.errors).forEach((fieldName) => {
              const inputEl = form.querySelector(`[name="${fieldName}"]`);
              if (inputEl) {
                inputEl.classList.add("form-input--error");
              }
            });
          }

          errorText.textContent = result.message || "Ocurrió un error al enviar el formulario. Por favor verifica tus datos.";
          errorFeedback.hidden = false;
        }
      } catch (error) {
        console.error("Error de red al enviar formulario:", error);
        errorText.textContent = "No pudimos conectar con el servidor. Por favor comprueba tu conexión a internet e inténtalo de nuevo.";
        errorFeedback.hidden = false;
      } finally {
        // Restaurar estado del botón
        submitBtn.disabled = false;
        submitBtn.removeAttribute("aria-busy");
        submitBtn.textContent = originalBtnText;
      }
    });
  });
</script>
