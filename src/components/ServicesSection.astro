---
import { Image } from "astro:assets";
import serviceImage1 from "/src/assets/images/service-1.webp";
import serviceImage2 from "/src/assets/images/service-2.webp";
import serviceImage3 from "/src/assets/images/service-3.webp";
import serviceImage4 from "/src/assets/images/service-4.webp";

interface ServiceCategory {
    id: string;
    badge: string;
    title: string;
    description: string;
    image: ImageMetadata;
    iconSvg: string;
    items: string[];
    subcategories?: {
        title: string;
        items: string[];
    }[];
}

const serviceCategories: ServiceCategory[] = [
    {
        id: "administrativos",
        badge: "01. Operación",
        title: "Servicios Administrativos",
        description:
            "Gestión eficiente y control operativo continuo para la administración de tu personal.",
        image: serviceImage1,
        iconSvg: `<svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/></svg>`,
        items: [
            "Administración integral de nómina.",
            "Gestión de incidencias.",
            "Altas y bajas de personal.",
            "Control de expedientes y documentación.",
            "Elaboración de reportes administrativos.",
            "Gestión de contratos laborales.",
            "Control de vacaciones y prestaciones.",
        ],
    },
    {
        id: "contables",
        badge: "02. Finanzas",
        title: "Servicios Contables",
        description:
            "Información financiera precisa, control de ingresos, egresos y cumplimiento fiscal riguroso.",
        image: serviceImage2,
        iconSvg: `<svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>`,
        items: [
            "Contabilidad general.",
            "Elaboración de estados financieros.",
            "Conciliaciones bancarias.",
            "Declaraciones fiscales y planeación.",
            "Control de ingresos y egresos.",
            "Facturación electrónica y asesoría.",
            "Cumplimiento de obligaciones fiscales.",
        ],
    },
    {
        id: "juridicos",
        badge: "03. Legal",
        title: "Servicios Jurídicos",
        description:
            "Protección legal integral, prevención de riesgos y representación especializada.",
        image: serviceImage3,
        iconSvg: `<svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 2L1 21h22L12 2zm0 3.99L19.53 19H4.47L12 5.99zM11 16h2v2h-2zm0-6h2v4h-2z"/></svg>`,
        items: [],
        subcategories: [
            {
                title: "Asesoría Laboral",
                items: [
                    "Consultoría en materia laboral.",
                    "Prevención de riesgos legales.",
                    "Interpretación de legislación laboral.",
                ],
            },
            {
                title: "Apoyo & Gestión Legal",
                items: [
                    "Elaboración y revisión de contratos.",
                    "Defensa laboral ante autoridades.",
                    "Atención de auditorías laborales.",
                ],
            },
        ],
    },
    {
        id: "nomina",
        badge: "04. Cumplimiento",
        title: "Servicios Relacionados con Nómina",
        description:
            "Alineación de procesos de nómina con autoridades laborales e instituciones gubernamentales.",
        image: serviceImage4,
        iconSvg: `<svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-5.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>`,
        items: [
            "Cumplimiento en materia laboral.",
            "Revisión de obligaciones patronales.",
            "Asesoría en IMSS, INFONAVIT y autoridades.",
            "Prevención de contingencias legales.",
        ],
    },
];
---

<section id="servicios" class="services-section">
    <div class="section-container">
        <div class="services-header">
            <span class="section-tag">SERVICIOS ESPECIALIZADOS</span>
            <h2 class="section-title">
                Soluciones integrales para tu empresa.
            </h2>
            <p class="services-subtitle-text">
                Ofrecemos un catálogo completo de servicios diseñados para
                resolver procesos críticos en materia administrativa, contable y
                jurídica.
            </p>
        </div>

        <div class="services-grid">
            {
                serviceCategories.map((category) => (
                    <article class="service-card" data-service-id={category.id}>
                        <div class="card-image-wrap">
                            <Image
                                src={category.image}
                                alt={category.title}
                                class="card-image"
                                loading="lazy"
                                width="600"
                                height="380"
                            />
                            <div class="card-badge">{category.badge}</div>
                            <div class="card-icon" aria-hidden="true">
                                <Fragment set:html={category.iconSvg} />
                            </div>
                        </div>

                        <div class="card-content">
                            <h3 class="card-title">{category.title}</h3>
                            <p class="card-desc">{category.description}</p>

                            <div class="card-details-collapsible">
                                <div class="details-inner">
                                    {category.items.length > 0 && (
                                        <ul class="card-list">
                                            {category.items.map((item) => (
                                                <li class="card-list-item">
                                                    <span
                                                        class="bullet-dot"
                                                        aria-hidden="true"
                                                    >
                                                        •
                                                    </span>
                                                    <span>{item}</span>
                                                </li>
                                            ))}
                                        </ul>
                                    )}

                                    {category.subcategories &&
                                        category.subcategories.map((sub) => (
                                            <div class="subcategory-block">
                                                <h4 class="subcategory-title">
                                                    {sub.title}
                                                </h4>
                                                <ul class="card-list">
                                                    {sub.items.map((item) => (
                                                        <li class="card-list-item">
                                                            <span
                                                                class="bullet-dot"
                                                                aria-hidden="true"
                                                            >
                                                                •
                                                            </span>
                                                            <span>{item}</span>
                                                        </li>
                                                    ))}
                                                </ul>
                                            </div>
                                        ))}
                                </div>
                            </div>

                            <button
                                type="button"
                                class="card-toggle-btn"
                                aria-expanded="false"
                            >
                                <span class="toggle-text-show">
                                    Ver detalles
                                </span>
                                <span class="toggle-text-hide">
                                    Ocultar detalles
                                </span>
                                <svg
                                    class="toggle-chevron"
                                    viewBox="0 0 24 24"
                                    width="18"
                                    height="18"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <polyline points="6 9 12 15 18 9" />
                                </svg>
                            </button>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .services-section {
        background-color: var(--color-white, #ffffff);
    }

    .services-header {
        max-width: 52rem;
        margin-bottom: var(--px-48);
    }

    .services-header .section-title {
        margin-bottom: var(--px-16);
    }

    .services-subtitle-text {
        font-size: var(--text-lg);
        line-height: 1.6;
        margin-top: 0;
        margin-bottom: 0;
        opacity: 0.8;
    }

    /* Balanced 2-Column Services Grid */
    .services-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--px-32);
        align-items: start;
    }

    @media (min-width: 48rem) {
        .services-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .service-card {
        background-color: var(--color-white, #ffffff);
        border-radius: var(--radius-lg, 12px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        position: relative;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
    }

    .service-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08);
    }

    .card-image-wrap {
        height: 12rem;
        width: 100%;
        overflow: hidden;
        position: relative;
        background-color: var(--color-background, #f1f1f1);
    }

    .card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease-out;
    }

    .service-card:hover .card-image {
        transform: scale(1.05);
    }

    .card-badge {
        position: absolute;
        top: 16px;
        left: 16px;
        background: linear-gradient(
            135deg,
            rgba(15, 23, 42, 0.2) 0%,
            rgba(67, 106, 143, 0.2) 40%,
            rgba(204, 48, 183, 0.2) 100%
        );
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        padding: var(--px-6) var(--px-16);
        border-radius: 9999px;
        z-index: 10;
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: white;
        margin-bottom: var(--px-8);
    }

    .card-icon {
        position: absolute;
        bottom: 16px;
        right: 16px;
        background: linear-gradient(
            135deg,
            rgba(15, 23, 42, 0.2) 0%,
            rgba(67, 106, 143, 0.2) 40%,
            rgba(204, 48, 183, 0.2) 100%
        );
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        padding: 10px;
        border-radius: 9999px;
        z-index: 10;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-content {
        padding: var(--px-32);
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .card-title {
        font-size: var(--text-xl);
        font-weight: 600;
        margin: 0 0 var(--px-12) 0;
        color: var(--color-text-primary);
        line-height: 1.25;
    }

    .card-desc {
        font-size: var(--text-sm);
        line-height: 1.5;
        opacity: 0.8;
        margin: 0;
    }

    /* Contenedor Colapsable Suave con Grid Animation */
    .card-details-collapsible {
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        overflow: hidden;
        transition:
            grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1),
            opacity 0.3s ease,
            margin-top 0.3s ease;
        margin-top: 0;
    }

    .details-inner {
        overflow: hidden;
    }

    .service-card.is-expanded .card-details-collapsible {
        grid-template-rows: 1fr;
        opacity: 1;
        margin-top: var(--px-20);
    }

    .card-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--px-10);
    }

    .card-list-item {
        display: flex;
        align-items: flex-start;
        gap: var(--px-8);
        font-size: var(--text-sm);
        line-height: 1.5;
    }

    .bullet-dot {
        font-weight: bold;
        opacity: 0.4;
    }

    .subcategory-block {
        margin-top: var(--px-8);
        padding-top: var(--px-12);
        border-top: 1px dashed rgba(0, 0, 0, 0.08);
    }

    .subcategory-title {
        font-size: var(--text-base);
        font-weight: 600;
        margin-bottom: var(--px-10);
        color: var(--color-text-primary);
    }

    /* Botón de Despliegue de Detalles */
    .card-toggle-btn {
        margin-top: var(--px-20);
        padding-top: var(--px-16);
        border: none;
        border-top: 1px solid rgba(0, 0, 0, 0.08);
        background: transparent;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-text-primary);
        transition: color var(--transition-short);
    }

    .card-toggle-btn:hover {
        color: var(--color-grow-blue, #23b5ec);
    }

    .toggle-text-hide {
        display: none;
    }

    .service-card.is-expanded .toggle-text-show {
        display: none;
    }

    .service-card.is-expanded .toggle-text-hide {
        display: inline;
    }

    .toggle-chevron {
        transition: transform 0.3s ease;
        flex-shrink: 0;
    }

    .service-card.is-expanded .toggle-chevron {
        transform: rotate(180deg);
    }

    @media screen and (max-width: 48rem) {
        .card-content {
            padding: var(--px-24);
        }
    }
</style>

<script>
    const toggleBtns = document.querySelectorAll(".card-toggle-btn");

    toggleBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
            const card = btn.closest(".service-card");
            if (!card) return;

            const isExpanded = card.classList.contains("is-expanded");
            card.classList.toggle("is-expanded");
            btn.setAttribute("aria-expanded", String(!isExpanded));
        });
    });
</script>
