---
import "@styles/_variables.css";
import "@styles/_reset.css";
import "@styles/global.css";

import { Font } from "astro:assets";
import { SITE, SOCIALS } from "@consts";
import { ClientRouter } from "astro:transitions";
import Header from "components/Header.astro";
import Footer from "@components/Footer.astro";

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

const {
    companyName = SITE.COMPANY_NAME,
    legalName = SITE.LEGAL_NAME,
    title = `${SITE.COMPANY_NAME}: ${SITE.TITLE}`,
    description = SITE.DESCRIPTION,
    canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
    ogImage = SITE.OG_IMAGE,
    twitterHandle = SITE.TWITTER?.CREATOR,
} = Astro.props;

const socialImageURL = new URL(
    ogImage ?? SITE.OG_IMAGE ?? "og-image.webp",
    Astro.url.origin,
).href;

const schemaData = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: `${title}`,
    url: `${canonicalURL}`,
    description: `${description}`,
    isPartOf: {
        "@type": "WebSite",
        name: `${companyName}`,
        url: `${canonicalURL}`,
        publisher: {
            "@type": "Organization",
            name: `${companyName}`,
            legalName: legalName,
            url: `${canonicalURL}`,
            "@id": `${canonicalURL}`,
            sameAs: SOCIALS.map((social) => social.HREF),
        },
    },
};
---

<!doctype html>
<html lang=`${SITE.LOCALE ?? "en"}`>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={canonicalURL} />
        <!-- Preload fonts -->
        <Font cssVariable="--font-dm-sans" />

        <meta name="generator" content={Astro.generator} />

        <ClientRouter />

        <!-- General Meta Tags -->
        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="author" content={legalName} />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="es_MX" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageURL} />

        <!-- Twitter -->
        <meta property="twitter:card" content={SITE.TWITTER?.CARD} />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImageURL} />
        {
            twitterHandle && (
                <meta property="twitter:creator" content={twitterHandle} />
            )
        }

        <!-- Google JSON-LD Structured data -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify(schemaData)}
        />

        {
            // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
            // include google-site-verification tag in the heading
            // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
            googleSiteVerification && (
                <meta
                    name="google-site-verification"
                    content={googleSiteVerification}
                />
            )
        }
    </head>
    <body>
        <!-- Site-wide Multi-color Ambient Background & Geometric SVG Shapes -->
        <div class="site-ambient-canvas" aria-hidden="true">
            <!-- Glowing GROW Cyan Ambient Orb 1 (Top Left / Center) -->
            <svg class="ambient-svg shape-orb-1" viewBox="0 0 800 800" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="400" cy="400" r="380" fill="url(#grow-orb-cyan)" />
                <defs>
                    <radialGradient id="grow-orb-cyan" cx="0.5" cy="0.5" r="0.5">
                        <stop offset="0%" stop-color="#23b5ec" stop-opacity="0.18" />
                        <stop offset="60%" stop-color="#23b5ec" stop-opacity="0.05" />
                        <stop offset="100%" stop-color="#23b5ec" stop-opacity="0" />
                    </radialGradient>
                </defs>
            </svg>

            <!-- Glowing GROW Pink/Magenta Ambient Orb 2 (Center Right) -->
            <svg class="ambient-svg shape-orb-2" viewBox="0 0 900 900" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="450" cy="450" r="420" fill="url(#grow-orb-pink)" />
                <defs>
                    <radialGradient id="grow-orb-pink" cx="0.5" cy="0.5" r="0.5">
                        <stop offset="0%" stop-color="#ec6eba" stop-opacity="0.14" />
                        <stop offset="65%" stop-color="#ec6eba" stop-opacity="0.04" />
                        <stop offset="100%" stop-color="#ec6eba" stop-opacity="0" />
                    </radialGradient>
                </defs>
            </svg>

            <!-- Glowing Violet/Blue Ambient Orb 3 (Bottom Left) -->
            <svg class="ambient-svg shape-orb-3" viewBox="0 0 700 700" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="350" cy="350" r="330" fill="url(#grow-orb-violet)" />
                <defs>
                    <radialGradient id="grow-orb-violet" cx="0.5" cy="0.5" r="0.5">
                        <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.12" />
                        <stop offset="70%" stop-color="#7c3aed" stop-opacity="0.03" />
                        <stop offset="100%" stop-color="#7c3aed" stop-opacity="0" />
                    </radialGradient>
                </defs>
            </svg>

            <!-- Geometric Floating SVG Shape: Isometric Tech Contour Waves & Grid -->
            <svg class="ambient-svg shape-waves" viewBox="0 0 1440 900" fill="none" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
                <g opacity="0.45">
                    <path d="M-200 150 C 200 450, 700 -50, 1600 350" stroke="url(#line-grad-1)" stroke-width="1.5" stroke-dasharray="8 8" fill="none" />
                    <path d="M-100 300 C 350 650, 900 100, 1700 500" stroke="url(#line-grad-2)" stroke-width="1.5" fill="none" />
                    <path d="M-150 700 C 400 350, 850 850, 1650 250" stroke="url(#line-grad-1)" stroke-width="1.2" stroke-dasharray="12 6" fill="none" />
                    <circle cx="15%" cy="25%" r="180" stroke="rgba(35, 181, 236, 0.15)" stroke-width="1" stroke-dasharray="4 6" fill="none" />
                    <circle cx="85%" cy="65%" r="240" stroke="rgba(236, 110, 186, 0.12)" stroke-width="1" stroke-dasharray="6 8" fill="none" />
                    <circle cx="50%" cy="85%" r="320" stroke="rgba(35, 181, 236, 0.1)" stroke-width="1" fill="none" />
                </g>
                <defs>
                    <linearGradient id="line-grad-1" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="#23b5ec" stop-opacity="0" />
                        <stop offset="50%" stop-color="#23b5ec" stop-opacity="0.4" />
                        <stop offset="100%" stop-color="#ec6eba" stop-opacity="0" />
                    </linearGradient>
                    <linearGradient id="line-grad-2" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="#ec6eba" stop-opacity="0" />
                        <stop offset="50%" stop-color="#ec6eba" stop-opacity="0.35" />
                        <stop offset="100%" stop-color="#23b5ec" stop-opacity="0" />
                    </linearGradient>
                </defs>
            </svg>
        </div>
        <a href="#main" class="skip-link">Ir al contenido</a>

        <Header />
        <main id="main" tabindex="-1">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    .skip-link {
        position: absolute;
        top: var(--px-10);
        left: var(--px-8);
        transform: translateY(-200%);
        padding: var(--px-12) var(--px-16);
        border-radius: var(--px-6);
        color: white;
        background: #000;
        z-index: 1001;
        opacity: 0;
        transition: opacity var(--transition-short);
    }

    .skip-link:focus-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>
